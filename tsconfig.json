{
	"compilerOptions": {
	"target": "ES2019",
	"module": "commonjs",
	"outDir": "dist",
	"rootDir": ".",
	"strict": true,
	"esModuleInterop": true,
	"sourceMap": true,
	"moduleResolution": "node",
	"resolveJsonModule": true,
	"skipLibCheck": true
  },
	"include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
